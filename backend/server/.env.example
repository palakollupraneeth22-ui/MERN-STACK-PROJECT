# ========================================
# BACKEND ENVIRONMENT CONFIGURATION
# ========================================
# Copy this file to backend/server/.env and fill in your actual values
# DO NOT commit .env with real values to version control

# ========================================
# SERVER CONFIGURATION
# ========================================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ========================================
# DATABASE CONFIGURATION
# ========================================
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/course-progress-visualizer

# MongoDB Atlas (uncomment and update)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/course-progress-visualizer?retryWrites=true&w=majority

# ========================================
# JWT CONFIGURATION
# ========================================
# Use strong random strings in production (generate with: openssl rand -base64 32)
JWT_SECRET=your_very_secret_jwt_key_change_this_in_production_min_32_chars
JWT_REFRESH_SECRET=your_very_secret_refresh_key_change_this_in_production_min_32_chars
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Firebase Admin service account JSON string for server-side verification
# Example: FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
FIREBASE_SERVICE_ACCOUNT=

# ========================================
# EMAIL CONFIGURATION
# ========================================
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@course-progress-visualizer.com

# Email sending disabled by default
ENABLE_EMAIL_SENDING=false

# ========================================
# YOUTUBE API CONFIGURATION
# ========================================
# Get your API key from: https://console.cloud.google.com/
# Steps:
# 1. Create a Google Cloud project
# 2. Enable YouTube Data API v3
# 3. Create an API key credential
# 4. Paste the key below
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE
ENABLE_YOUTUBE_IMPORT=true

# ========================================
# AWS S3 CONFIGURATION (Optional)
# ========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# ========================================
# REDIS CONFIGURATION (Optional)
# ========================================
# For caching and distributed rate limiting
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ========================================
# FILE UPLOAD CONFIGURATION
# ========================================
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads
ENABLE_VIDEO_UPLOAD=true

# ========================================
# RATE LIMITING
# ========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=INFO
LOG_DIR=./logs

# ========================================
# SECURITY
# ========================================
BCRYPT_ROUNDS=12
PASSWORD_RESET_EXPIRES=3600000
EMAIL_VERIFICATION_EXPIRES=86400000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ========================================
# EXTERNAL SERVICES (Optional)
# ========================================
SENTRY_DSN=
MIXPANEL_TOKEN=
GOOGLE_ANALYTICS_KEY=

# Optional: Email Configuration (for future email features)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password

# Node Environment
NODE_ENV=development
